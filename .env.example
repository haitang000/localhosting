# 复制为 .env 后按需修改，改完重启面板生效。

# ---------- 面板 ----------
PANEL_PORT=8099
PANEL_HOST=0.0.0.0
# 面板名称（登录页、顶栏、浏览器标签）；只作首次播种，之后在
# 管理后台 → 总览 → 品牌设置里改，改完立即生效，不用重启
PANEL_NAME=localhosting
# 主题色 #RRGGBB（logo 和整套强调色都由它派生）；同上，后台可改
PANEL_COLOR=#006fee
# 站点描述（SEO）：写进首页 <meta name="description">，最多 200 字；同上，后台可改
PANEL_DESCRIPTION=云容器托管面板：一键部署 Minecraft 服务器、Nextcloud、WordPress、数据库等应用，自带实时控制台、文件管理、闲时休眠与自动唤醒。
# 面板放在 Nginx/Caddy 后面时打开，让限流拿到真实 IP
TRUST_PROXY=false
SESSION_TTL_DAYS=14

# 首次启动会用它创建管理员；留空则随机生成一个密码并打印在控制台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 注册 ----------
# 开放注册：不需要邀请码，靠面板自绘的验证码 + IP 限速挡机器人。
# 设 false 回到邀请码注册（此时验证码关闭，注册邀请码是唯一入口）
OPEN_REGISTRATION=true
# 同一 IP 每小时最多注册成功几个账号（失败另有指数退避管着）
REGISTER_IP_PER_HOUR=3
# 注册、登录前必须勾选同意《用户协议》。正文在 src/terms.js 里改，改完
# 把里面的 TERMS_VERSION 拨到新日期，所有人下次登录会重新确认一遍。
# 谁在何时同意了哪一版，users 表和审计日志里都有记录。设 false 整体关闭。
TERMS_REQUIRED=true

# ---------- 验证码（自研，零外部依赖） ----------
# 注册/登录/签到共用的四层防线：行为分析（轨迹+打字节奏，通过线随机浮动）
# → 工作量证明（sha256 前导零，对真人无感、对脚本是算力成本）→ 图片回正
#（旋转角度烘焙进几何坐标，标记里没有答案）→ 一次性 token（绑 IP、签发起
# 最短使用间隔）。失败多的 IP 的 PoW 难度会自动上调最高 4 位。
# 设 false 直接发 token，防机器人完全交给邀请码/限速。
CAPTCHA_ENABLED=true
# PoW 难度（前导零位数）：每 +1 位，脚本平均成本翻倍。20 位 ≈ 浏览器一两秒，
# 原生脚本零点几秒，是「让脚本逐个验证变贵」的主要闸门
CAPTCHA_POW_BITS=20
# 图片回正容差（度）：越小越难蒙，真人照样拖得准
CAPTCHA_TOLERANCE=10
# 挑战签发后至少等这么久才能提交（毫秒），秒答判脚本
CAPTCHA_MIN_SOLVE_MS=1000
# token 签发后至少等这么久才能用（毫秒）
CAPTCHA_MIN_TOKEN_AGE_MS=300
# 每 IP 同时最多几张未解的挑战图，防并行穷举角度
CAPTCHA_MAX_CHALLENGES_PER_IP=3
# 严格模式（默认值）：每次都要求完成图片回正，不靠行为分析放行 ——
# 行为信号是客户端自报的、可以伪造，只有图片题不能。发题前服务端会随机
# 裁剪+缩放+像素噪声，拿公开题图比对角度的那条脚本路也堵上。
# 只影响默认值 —— 管理后台「验证码严格程度」可随时切换，以后台设置为准。
CAPTCHA_STRICT=true
# 题图目录（PNG）。留空用仓库自带的 src/captcha-images/ —— 注意仓库里的题图
# 是公开的，攻击者可以拿原图做角度比对。要彻底堵死这条路，把方向明确（地平线、
# 建筑、道路等）的 PNG 放进自己的目录（比如 data/captcha-images/）再填这里。
CAPTCHA_IMAGES_DIR=

# ---------- Docker ----------
# 留空自动探测（Windows 用命名管道，Linux 用 /var/run/docker.sock）
# 也可写 tcp://127.0.0.1:2375 或 unix:///var/run/docker.sock
DOCKER_HOST=
CONTAINER_PREFIX=lh
DOCKER_NETWORK=bridge
PIDS_LIMIT=512
# 每个实例的可写层磁盘上限；只在部分存储驱动（overlay2 + xfs prjquota 等）上生效，
# Docker Desktop（Windows/Mac）会直接忽略，此时磁盘不受限
DISK_QUOTA=2G

# 磁盘配额兜底：DISK_QUOTA 在 Docker Desktop 上不生效，所以面板会自己每隔
# DISK_GUARD_CHECK_SECONDS 秒查一次每个实例数据卷的实际占用，超过
# DISK_QUOTA_MB 就自动停止该实例（状态栏会显示原因）。不是硬限制，两次检查
# 之间的突发写入仍可能短暂超额。
DISK_GUARD_ENABLED=true
DISK_QUOTA_MB=2048
DISK_GUARD_CHECK_SECONDS=60

# ---------- 实例控制台（浏览器里的实时终端）----------
# 每个会话保留多少字符的回滚内容，供刷新/换标签页后重新贴回来
CONSOLE_SCROLLBACK=200000
# 没有任何页面连着的会话，闲置多久后杀掉里面的 shell
CONSOLE_IDLE_MINUTES=30

# ---------- 端口池 ----------
# 用户实例从这个区间领取主机端口
PORT_POOL=20000-20200
# Docker 在宿主机上绑定的地址。
#  0.0.0.0   → 局域网可直连
#  127.0.0.1 → 只有本机能连，配合本机跑的内网穿透客户端最安全
BIND_ADDRESS=0.0.0.0

# ---------- 对外访问（内网穿透）----------
# 用户在面板上看到的地址 = PUBLIC_HOST:(主机端口 + PUBLIC_PORT_OFFSET)
# 例：frp 里把 20000-20200 整段转发到同名远端端口，这里填 frp 服务器域名即可
PUBLIC_HOST=
PUBLIC_PORT_OFFSET=0
PUBLIC_SCHEME=http

# 面板自己在公网上的入口，例 http://1.2.3.4:8099 或 https://panel.example.com
# 静态站点是面板亲自发的（走面板端口，不占端口池），所以站点地址跟着这个走。
# 留空则按 PUBLIC_HOST + 面板端口猜；两个都空就只能显示 localhost，外网打不开。
PANEL_PUBLIC_URL=

# ---------- 自动穿透（Cloudflare Tunnel）----------
# 开这个之后，管理员审批时勾「自动创建 Cloudflare Tunnel」（或自己建实例时勾
# 「自动穿透」），面板自动建命名隧道、在 CF_TUNNEL_DOMAIN 下分配子域名、
# 拉起 cloudflared 进程，并把 https://<实例名>.<域名> 自动填进对外地址 ——
# 不用手动配 frp / cloudflared / 路由器转发。
# 需要：机器上装 cloudflared（在 PATH 里），以及一个 Cloudflare API Token
#（权限：Zone:DNS:Edit + Cloudflare Tunnel:Edit，作用于目标 Zone/Account）。
CF_TUNNEL_ENABLED=false
# 只写在 .env 里，永远不会通过接口返回
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
# 子域名都挂在它下面，例 apps.example.com → myapp-abc123.apps.example.com
CF_TUNNEL_DOMAIN=
# 隧道名前缀；凭据和 ingress 配置存在 CF_TUNNEL_CRED_DIR
CF_TUNNEL_PREFIX=lh
CF_TUNNEL_BIN=cloudflared
CF_TUNNEL_CRED_DIR=

# ---------- 账号级上限 ----------
# 内存 / CPU / 端口由「实例资源券」决定，账号这边只限制能同时开几个实例
DEFAULT_MAX_INSTANCES=5
# 账号级的自定义镜像权限；也可以只在某张资源券上单独开
DEFAULT_ALLOW_CUSTOM_IMAGE=false

# ---------- 区域总算力上限 ----------
# 所有用户、所有实例合计的内存 / CPU 封顶（整台宿主机的可售算力）。
# 到顶后新建实例会提示「当前区域已无剩余算力，请稍后再试」。0 = 不限制。
REGION_MAX_MEMORY_MB=32768
REGION_MAX_CPUS=20

# ---------- 实例资源券 ----------
# 删除实例时把券的次数退回，用户就敢放心重建；设 false 则每张券严格一次性
REFUND_INVITE_ON_DELETE=true
# 创建失败（镜像拉不下来等）时退回次数
REFUND_INVITE_ON_FAILURE=true
# 管理后台「生成资源券」表单的默认值
VOUCHER_DEFAULT_MEMORY_MB=1024
VOUCHER_DEFAULT_CPUS=1
VOUCHER_DEFAULT_PORTS=2
# 用这张券建出来的实例能活多少天，0 = 永久。天数在建实例时抄到实例上，
# 从「管理员放行、开始建容器」那一刻算起（排队等审批的时间不算）。
VOUCHER_DEFAULT_DAYS=0

# ---------- 积分定价 ----------
# 基础价包含的规格：128MB / 0.1 核 / 1 个端口 / 2048MB 硬盘 / 7 天
INSTANCE_POINTS_COST=100
POINTS_INSTANCE_MEMORY_MB=128
POINTS_INSTANCE_CPUS=0.1
POINTS_INSTANCE_PORTS=1
POINTS_INSTANCE_DAYS=7
POINTS_INSTANCE_DISK_MB=2048
# 加配价目：内存每 +128MB 收 40 分；CPU 每 +0.1 核收 10 分；
# 端口从第 2 个起每个 10 分；硬盘每 +2048MB 收 100 分
POINTS_MEM_STEP_MB=128
POINTS_MEM_STEP_COST=40
POINTS_CPU_STEP_COST=10
POINTS_PORT_COST=10
POINTS_DISK_STEP_MB=2048
POINTS_DISK_STEP_COST=100
# 加配封顶
POINTS_MAX_MEMORY_MB=16384
POINTS_MAX_CPUS=8
POINTS_MAX_PORTS=4
POINTS_MAX_DISK_MB=16384
# 套餐（内存+CPU+硬盘打包价）首次启动的种子；之后在管理后台「套餐」页改，
# 存在数据库里，这里改不再生效。字段：name / memoryMb / cpus / diskMb / cost /
# days（实例时长，0=永久，省略=跟随全局 POINTS_INSTANCE_DAYS）/ stock（剩余份数，
# 省略=-1 不限量，每建一个实例扣 1，驳回/失败/删除退 1）
# POINTS_BUNDLES=[{"name":"2c2g","memoryMb":2048,"cpus":2,"diskMb":2048,"cost":650,"days":30,"stock":10}]
# 实例数据卷配额说明：积分实例用上面的档位/套餐，资源券实例和没有 disk_mb 的
# 老实例回退全局 DISK_QUOTA_MB（见 Docker 一节）。超量自动停止是轮询兜底，
# 不是硬限；Docker Desktop 上 StorageOpt 不生效，就靠这一层。

# ---------- 实例有效期：到期封存 ----------
# 有效期一到，面板停掉容器、关掉控制台、收回它占着的端口，状态转为「已封存」。
# 多长时间扫一次即将到期 / 宽限期届满要清理的实例：
EXPIRY_CHECK_SECONDS=60
# 封存后保留天数（宽限期）：到期后数据再留 N 天，期间可下载或积分续期；超期自动彻底删除。
# 设 0 关闭自动删除（旧的封存不删行为）。
ARCHIVE_RETENTION_DAYS=7
# 积分续期定价：一次续 N 天收多少积分（默认 100 积分续 7 天，与基础实例同价）
RENEWAL_POINTS_COST=100
# 一次续几天（默认 7 天）
RENEWAL_DAYS=7

# ---------- 新用户见面礼 ----------
# 每个新注册的账号自动收到一张「只能发静态网页」的券：不建容器、不占端口，
# 额度就是下面 SITE_CPUS / SITE_MEMORY_MB 那个数。开放注册时它是最省心的欢迎方式，
# 想让新人一律空手进来就设 false。（SITES_ENABLED=false 时本项自动失效）
WELCOME_VOUCHER=true
# 送的这张券能用几次 = 新人能同时挂几个静态站点
WELCOME_VOUCHER_USES=1
# 见面礼多少天后过期，0 = 永久
WELCOME_VOUCHER_DAYS=0

# 允许自定义镜像时，镜像可以来自哪些仓库（空串代表 Docker Hub 短名）
ALLOWED_REGISTRIES=,docker.io,ghcr.io,registry.hub.docker.com,quay.io

# ---------- 静态站点（把 HTML 拖进面板就部署）----------
# 由面板自己提供，不建容器、不占端口：只要面板能被访问，站点就能被访问
SITES_ENABLED=true
# 发布站点同样要花一张券：静态网页专用券，或任意一张实例资源券；设 false 则登录即可发布
SITE_REQUIRE_INVITE=true
# 一个静态站点的记账口径。背后没有容器，所以这是个名义值：哪怕用户花的是
# 1024MB 的大券，发个网页也只按这么点算，不会白白吃掉一整台机器的额度。
SITE_MEMORY_MB=32
SITE_CPUS=0.1
DEFAULT_MAX_SITES=5
SITE_MAX_BYTES=20971520
SITE_MAX_FILES=300
# 用户页面跑在面板同一个源上。开着这个开关，页面会被 CSP sandbox 关进独立源，
# 拿不到面板的 Cookie、也调不动面板 API。只有当你把站点放到另一个域名下时才关掉它。
SITE_SANDBOX=true
# 给站点单独指了域名的话填这里（例：https://pages.example.com），
# 面板显示的地址就变成 <这个地址>/<站点名>/；留空则显示 <面板地址>/s/<站点名>/
SITE_PUBLIC_BASE=

# ---------- 公告配图 ----------
# 管理后台发公告时可以上传图片，以 Markdown 形式插进正文（存 data/announcement-images/，
# 只认 PNG / JPG / GIF / WebP / AVIF，按文件头校验；不用的图片启动时自动清理）
ANNOUNCEMENT_IMAGE_MAX_BYTES=4194304

# ---------- 闲时休眠（没人用就停，有人访问再起）----------
# 实例休眠期间容器是停止的，不占内存和 CPU；面板替它守着对外端口，
# 第一个连进来的请求会被暂存，容器起来之后再转发进去（冷启动通常 1-3 秒）。
# 只对 TCP 端口有效，UDP 服务无法这样唤醒。
IDLE_SLEEP=true
# 新建实例时是否默认勾上「闲时休眠」
IDLE_SLEEP_DEFAULT=false
# 容器网络流量多少分钟没有变化就算空闲（用户可以按实例单独改）
IDLE_MINUTES=15
# 多久检查一次空闲
SLEEP_CHECK_SECONDS=30
# 唤醒时等容器端口就绪的上限
WAKE_TIMEOUT_MS=90000
